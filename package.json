{
  "name": "dash_pdf",
  "version": "0.0.1",
  "description": "Dash button for printing to PDF",
  "main": "build/index.js",
  "scripts": {
    "css": "NODE_ENV=production npx tailwindcss -i ./src/lib/css/input.css -o ./src/lib/css/output.css",
    "start": "webpack serve --config ./webpack.serve.config.js --open",
    "clean": "find ./dash_pdf -type f ! -name '__init__.py' -delete",
    "validate-init": "python _validate_init.py",
    "prepublishOnly": "yarn run validate-init",
    "build:js": "webpack --mode production",
    "build:backends": "dash-generate-components ./src/lib/components dash_pdf -p package-info.json --ignore \\.test\\.",
    "build:backends-activated": "(. venv/bin/activate || venv\\scripts\\activate && yarn run build:backends)",
    "build": "yarn run clean && yarn run css && yarn run build:js && yarn run build:backends",
    "bundle": "NODE_ENV=production yarn run build && python setup.py sdist bdist_wheel",
    "build:activated": "yarn run build:js && yarn run build:backends-activated",
    "rebuild": "yarn run build && poetry install && python usage.py"
  },
  "author": "Sean McCarthy <sean.mccarthy@live.ca>",
  "license": "MIT",
  "dependencies": {
    "ramda": "^0.26.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.23.9",
    "@babel/core": "^7.23.9",
    "@babel/eslint-parser": "^7.23.10",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.23.3",
    "@plotly/webpack-dash-dynamic-import": "^1.3.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.10.0",
    "es-check": "^7.1.1",
    "esbuild-loader": "^4.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.33.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.47",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.2.4",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-docgen": "^5.4.3",
    "react-dom": "^18.2.0",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "styled-jsx": "^5.1.2",
    "tailwindcss": "^3.4.14",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.0"
  },
  "engines": {
    "node": ">=8.11.0",
    "npm": ">=6.1.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
